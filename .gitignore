# ===== RAW EMBEDDING DUMPS & VECTOR INDEX BINARIES =====
# Keep *.pkl in models/ (small SVM/scaler). Do not ignore models/*.json.
*.f32
*.faiss
*.ckpt
index_metadata.pickle

# Chroma HNSW collections outside data/chromadb/ (that tree is already ignored)
**/chroma_chunks/

# ===== GENERATED INDEX ARCHIVES (targeted; do not ignore all zips) =====
# 1.8 GB Phase 4 chunk ANN dump. Reports/CSVs in this folder stay trackable.
experiments/phase4_chunk_ann/phase4a_chunk_index.zip
experiments/phase4_chunk_ann/artifacts/_cpu_partial_backup/
results.zip

# Obsolete duplicates moved during finalization (live Phase 8–12 reports stay)
experiments/archive/

