# Raw datasets (hundreds of MBs). Third-party news text is not shipped.
data/*.csv
data/*.txt
data/*.parquet
data/*.xlsx

# Numpy embeddings (100–200 MB each)
data/*.npy
data/*.npz
*.npy
*.npz

# Large binary / model weights
*.bin
*.pt
*.pth
*.h5

# Pretrained sentence transformer models
